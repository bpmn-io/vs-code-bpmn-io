{
  "name": "vs-code-bpmn-flex",
  "displayName": "BPMN.flex Editor",
  "description": "Edit BPMN 2.0 files, powered by bpmn.io tools. Add more custom features",
  "license": "MIT",
  "version": "0.20.0",
  "publisher": "gikoyo",
  "repository": {
    "type": "git",
    "url": "https://github.com/yougikou/vs-code-bpmn-flex"
  },
  "engines": {
    "vscode": "^1.79.2",
    "node": ">= 16"
  },
  "icon": "resources/logo_marketplace.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "bpmn"
  ],
  "activationEvents": [
    "onCommand:extension.bpmn-flex.edit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bpmn-flex.bpmnEditor.new",
        "title": "Create new BPMN Document",
        "category": "BPMN"
      }
    ],
    "keybindings": [
      {
        "command": "",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      },
      {
        "command": "",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      },
      {
        "command": "",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      },
      {
        "command": "",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      },
      {
        "command": "",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      },
      {
        "command": "",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      },
      {
        "command": "",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "bpmn-flex.bpmnEditor.canvasFocused"
      }
    ],
    "customEditors": [
      {
        "viewType": "bpmn-flex.bpmnEditor",
        "displayName": "BPMN Editor",
        "selector": [
          {
            "filenamePattern": "*.bpmn"
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "BPMN.flex Configuration",
      "properties": {
        "bpmn-flex.commonProperties": {
          "type": "array",
          "description": "Custom properties applicable to all BPMN elements. Each property defines a data source, UI control, and metadata.",
          "items": {
            "$ref": "#/definitions/propertyDefinition"
          },
          "default": []
        },
        "bpmn-flex.elementSpecificProperties": {
          "type": "object",
          "description": "Properties specific to certain BPMN element types. Key = BPMN element type (e.g. 'bpmn:Task', 'bpmn:Process').",
          "additionalProperties": {
            "type": "array",
            "description": "Properties for this element type.",
            "items": {
              "$ref": "#/definitions/propertyDefinition"
            },
            "default": []
          },
          "default": {}
        }
      },
      "definitions": {
        "propertyDefinition": {
          "type": "object",
          "title": "Property Definition",
          "required": [
            "label",
            "path",
            "source",
            "control"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "Display label shown in the sidebar."
            },
            "path": {
              "type": "string",
              "description": "Path to the data within the BPMN element. For engine=moddle (default): '@attrName' for attributes, 'ns:elemName' for child elements, '/' to nest. For engine=xpath: real XPath expression (e.g., '@name', 'bpmn:documentation/text()')."
            },
            "engine": {
              "type": "string",
              "enum": [
                "moddle",
                "xpath"
              ],
              "description": "Resolution engine: 'moddle' (default) navigates the BPMN moddle object tree, 'xpath' uses real XML XPath queries against the serialized diagram."
            },
            "source": {
              "type": "string",
              "enum": [
                "attribute",
                "text",
                "embedded"
              ],
              "description": "Data source type: 'attribute' = XML attribute value, 'text' = child element text content, 'embedded' = parsed field inside child element text (JSON or YAML)."
            },
            "control": {
              "type": "string",
              "enum": [
                "text",
                "textarea",
                "number",
                "boolean",
                "date",
                "select",
                "code"
              ],
              "description": "UI control type for editing the value."
            },
            "format": {
              "type": "string",
              "enum": [
                "json",
                "yaml"
              ],
              "description": "Format of the embedded content (required when source='embedded')."
            },
            "field": {
              "type": "string",
              "description": "Dot-separated path to the field inside embedded JSON/YAML content (used with source='embedded'). Example: 'service.name', 'retry.count'."
            },
            "options": {
              "type": "array",
              "description": "Dropdown options (required when control='select').",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Option display text."
                  },
                  "value": {
                    "type": "string",
                    "description": "Option value."
                  }
                }
              }
            },
            "min": {
              "type": "number",
              "description": "Minimum value (control='number')."
            },
            "max": {
              "type": "number",
              "description": "Maximum value (control='number')."
            },
            "step": {
              "type": "number",
              "description": "Step increment (control='number')."
            },
            "pattern": {
              "type": "string",
              "description": "Regular expression for input validation."
            },
            "defaultValue": {
              "type": "string",
              "description": "Default value when creating a new element."
            },
            "placeholder": {
              "type": "string",
              "description": "Placeholder text shown when the input is empty."
            },
            "description": {
              "type": "string",
              "description": "Help text shown as a tooltip on hover."
            },
            "group": {
              "type": "string",
              "description": "Group name for collapsible sections in the sidebar."
            },
            "order": {
              "type": "number",
              "description": "Sort order within the group (lower = first)."
            },
            "autoCreate": {
              "type": "boolean",
              "description": "When true (default), missing intermediate moddle objects are automatically created during property updates. Set to false to disable."
            }
          }
        }
      }
    }
  },
  "scripts": {
    "all": "run-s lint test",
    "lint": "npx eslint -c eslint.config.mjs .",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce pack",
    "changelog": "node scripts/extract-changelog.js",
    "release:check": "node -e \"const v=require('./package.json').version;const t=process.env.TAG||'';console.log(t==='v'+v?'OK v'+v:'MISMATCH: tag='+t+' pkg='+v);process.exit(t==='v'+v?0:1)\"",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "compile": "run-s compile:clean compile:app compile:tests",
    "compile:app": "rollup -c rollup.config.mjs",
    "compile:tests": "tsc -p ./src/test",
    "compile:clean": "shx rm -rf out",
    "watch:app": "npm run compile:app -- -w",
    "watch": "run-p watch:*",
    "pretest": "run-s compile",
    "test": "node ./out/test/run-tests.js",
    "test:unit": "tsc -p ./src/test && mocha --timeout 5000 out/test/unit/*.test.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@rollup/plugin-url": "^8.0.2",
    "@types/chai": "^4.3.20",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.6",
    "@types/shelljs": "^0.8.15",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "@types/vscode": "1.79.0",
    "@vscode/test-electron": "^3.1.0",
    "chai": "^4.5.0",
    "eslint": "^9.14.0",
    "eslint-plugin-bpmn-io": "^2.0.2",
    "glob": "^11.0.0",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.4",
    "npm-run-all2": "^8.0.0",
    "puppeteer": "^24.35.0",
    "rollup": "^4.27.0",
    "rollup-plugin-css-only": "^4.5.2",
    "shelljs": "^0.8.5",
    "shx": "^0.3.4",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.35",
    "bpmn-js": "^18.22.1",
    "bpmn-js-color-picker": "^0.7.1",
    "bpmn-js-i18n": "^2.3.0",
    "tslib": "^2.8.1",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.34"
  },
  "bundledDependencies": [
    "tslib"
  ],
  "bundleDependencies": [
    "tslib"
  ]
}
